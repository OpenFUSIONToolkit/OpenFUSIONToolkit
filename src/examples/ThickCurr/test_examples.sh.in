#!/bin/bash

log_path=$1
ROOT_PATH=$(pwd)

run_test() {
  cd $1
  start_time=$SECONDS
  jupyter nbconvert --execute --to notebook --inplace --ExecutePreprocessor.kernel_name=@OFT_PY_KERNEL@ $2 > tmp.log 2>&1
  if [ $? -ne 0 ]; then
    elapsed=$((SECONDS - start_time))
    echo "Example ThickCurr/$1/$2 failed in $elapsed seconds."
    echo "" >> $log_path
    echo "====== Begin ThickCurr/$1/$2 output ======" >> $log_path
    cat tmp.log >> $log_path
    echo "======  End ThickCurr/$1/$2 output  ======" >> $log_path
    echo "" >> $log_path
  else
    elapsed=$((SECONDS - start_time))
    echo "Example ThickCurr/$1/$2 ran successfully in $elapsed seconds."
  fi
  rm tmp.log
  cd $ROOT_PATH
}

# Slab cases
run_test slab ThickCurr_slab.ipynb

# Torus cases
run_test torus ThickCurr_torus.ipynb
