reset
undo off

brick x 1 y 0.1 z 0.01

move Volume 1  x 0 y 0 z 0.005 include_merged

nodeset 1 add surface 4
nodeset 2 add surface 6
nodeset 3 add surface 3 5
nodeset 4 add surface 1

volume 1 scheme tetmesh
volume 1 size 0.01
mesh volume 1

# Create mesh blocks
set duplicate block elements off
block 1 add volume 1

# Export grid
set large exodus file on
export Genesis  "MUG-railgun-tet.g" overwrite block 1

# Recreate with hexmesh
delete mesh volume 1 propagate
volume 1  scheme map
mesh volume 1 

# Create mesh blocks
set duplicate block elements off
block 1 add volume 1

# Export grid
set large exodus file on
export Genesis  "MUG-railgun-hex.g" overwrite block 1