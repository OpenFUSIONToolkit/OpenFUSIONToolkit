&runtime_options
 ppn=1                        !
 debug=0                      !
 test_run=T                   !
/

&mesh_options
 meshname='test'              !
 cad_type=0                   !
 nlevels=2                    !
 nbase=1                      !
 grid_order=2                 !
 fix_boundary=T               !
 part_meth=4                  !
/

&native_mesh_options
 filename='MUG-cyl_pinch.h5'  !
 reflect=T                    !
 ref_periodic=T               !
 zstretch=4.0                 !
 cyl_mesh=T                   !
/

&hcurl_op_options
 df_wop=0.,.65,.372,.324
 nu_wop=0,64,2,1
/

&lag_op_options
 df_lop=0.,.9,0.86,0.64
 nu_lop=0,64,2,1
/

&cyl_pinch_options
 order=2               !
 minlev=2              !
 n0=1.E19              !
 t0=50.0               !
 v0=-2.E0  !2.E4            !
 mm=2                  !
 eq_file='rwm_eq.dat'  !
 view_only=F           !
 plot_run=F            !
 pm=F                  !
/

&xmhd_options
 xmhd_adv_den=F    ! Advance density?
 xmhd_adv_temp=F   ! Advance temperature?
 bbc='bc'          ! Perfectly-conducting BC for B-field
 vbc='all'         ! Zero-flow BC for velocity
 nbc='d'           ! Dirichlet BC for density
 tbc='d'           ! Dirichlet BC for temperature
 dt=1.e-9          ! Maximum time step
 eta=10.           ! Resistivity at reference temperature (Spitzer-like)
 !eta_temp=6.       ! Reference temperature for resistivity
 visc_type='iso'   ! 
 nu_visc=4.0       ! Fluid viscosity
 d_dens=1.0        ! Density diffusion
 kappa_par=1.0     ! Parallel thermal conduction (fixed)
 kappa_perp=1.0    ! Perpendicular thermal conduction (fixed)
 nsteps=1000       ! Number of time steps to take
 rst_freq=10       ! Restart file frequency
 lin_tol=1.E-10    ! Linear solver tolerance
 nl_tol=1.E-5      ! Non-linear solver tolerance
 rst_ind=0         ! Index of file to restart from (0 -> use subroutine arguments)
 ittarget=40       ! Target for # of linear iterations per time step
 gmres_maxits=400  ! 
 gmres_ninner=50   ! 
 nclean=50         ! 
 mu_ion=2.         ! Ion mass (atomic units)
 xmhd_prefreq=20   ! Preconditioner update frequency
 xmhd_nparts=80,90,360,720 ! Preconditioner decompositions
 ! xmhd_nparts=0,10,40
/

&xmhd_plot_options
 t0=1.E-8         !
 dt=-1.0          !
 rst_end=2000     !
/
