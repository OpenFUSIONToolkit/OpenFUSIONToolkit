      "source": [
        "# VARYPED Equilibrium Scan Example\n",
        "\n",
        "Demonstrates the `varyped` module for creating equilibrium scans of self-consistently scaled pressure and current density profiles using input\n",
        "g-files and p-files.  \n",
        "\n",
        "**What this notebook covers:**\n",
        "1. Loading TokaMaker and input files\n",
        "2. Running scan with single scale value\n",
        "3. Running a full equilibrium scan with various scaling values\n",
        "4. Comparing original vs scaled profiles and run targets\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 1,
      "id": "427863e7",
      "metadata": {},
      "outputs": [],
      "source": [
        "import os\n",
        "import sys\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "plt.rcParams['figure.figsize']=(10,6)\n",
        "plt.rcParams['font.weight']='bold'\n",
        "plt.rcParams['axes.labelweight']='bold'\n",
        "plt.rcParams['lines.linewidth']=2\n",
        "plt.rcParams['lines.markeredgewidth']=2\n",
        "%matplotlib inline\n",
        "%config InlineBackend.figure_format = \"retina\""
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 2,
      "id": "acd9bf35",
      "metadata": {},
      "outputs": [],
      "source": [
        "tokamaker_python_path = 'PATH_TO_OFT'\n",
        "tokamaker_python_path = os.getenv(\"OFT_ROOTPATH\")\n",
        "#PATH_TO_OFT should be replaced with where your OFT is installed\n",
        "\n",
        "if tokamaker_python_path is not None:\n",
        "    sys.path.append(os.path.join(tokamaker_python_path,'python'))\n",
        "\n",
        "from OpenFUSIONToolkit import OFT_env\n",
        "from OpenFUSIONToolkit.TokaMaker import TokaMaker, meshing, eqdsk, varyped\n",
        
      ]
    },
    {
      "cell_type": "markdown",
      "id": "c9a6548e",
      "metadata": {},
      "source": [
        "## 1. Loading TokaMaker and input files"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 3,
      "id": "699c8185",
      "metadata": {},
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "#----------------------------------------------\n",
            "             ____  ____________\n",
