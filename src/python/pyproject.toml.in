[build-system]
requires = ["setuptools"]
#requires = ["setuptools>=77"] # For new license format (PEP 639; requires Python 3.9+)
build-backend = "setuptools.build_meta"

[project]
name = "OpenFUSIONToolkit"
maintainers = [
  {name = "Chris Hansen", email = "christopher.hansen@columbia.edu"}
]
description = "Modeling tools for plasma and fusion research and engineering"
readme = "README.md"
requires-python = ">=3.7"
keywords = ["Fusion", "Plasma", "TokaMaker", "ThinCurr"]
license = "LGPL-3.0-only"
#license-files = ["LICENSE"]  # Uncomment when Python 3.7 requirement is removed (see above)
classifiers = [
    "Development Status :: 5 - Production/Stable",
    "Programming Language :: C",
    "Programming Language :: Fortran",
    "Programming Language :: Python :: 3",
    "Topic :: Scientific/Engineering :: Physics"
]
dependencies = [
    "numpy",
    "scipy >= 1.11.0",
    "matplotlib",
    "h5py",
    "netCDF4"
]
version = "@CMAKE_PROJECT_VERSION@@OFT_PYPI_VER_SUFFIX@"

[project.urls]
Homepage = "https://openfusiontoolkit.github.io/OpenFUSIONToolkit/"
Documentation = "https://openfusiontoolkit.github.io/OpenFUSIONToolkit/docs/index.html"
Repository = "https://github.com/openfusiontoolkit/OpenFUSIONToolkit"
Issues = "https://github.com/openfusiontoolkit/OpenFUSIONToolkit/issues"

[project.scripts]
OFT_convert_hist = "OpenFUSIONToolkit.io:_convert_hist_cli"
OFT_build_XDMF = "OpenFUSIONToolkit._xdmf_cli:script_entry"
OFT_convert_cubit = "OpenFUSIONToolkit._cubit_cli:script_entry"
OFT_convert_gmsh = "OpenFUSIONToolkit._gmsh_cli:script_entry"
OFT_ThinCurr_holes = "OpenFUSIONToolkit.ThinCurr._homology_cli:script_entry"

[project.optional-dependencies]
viz = ["pyvista"]

[tool.setuptools.package-data]
OpenFUSIONToolkit = ["lib*"]

[tool.ruff]
# Assume Python 3.7 for OMFIT compatibility
target-version = "py37"

[tool.ruff.lint]
# Enable Pyflakes (`F`) and a subset of the pycodestyle (`E`) codes by default.
# Unlike Flake8, Ruff doesn't enable pycodestyle warnings (`W`) or
# McCabe complexity (`C901`) by default.
#select = ["E4", "E7", "E9", "F"]
ignore = ["E722", "F403", "F405"]